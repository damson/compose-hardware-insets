/.gradle/
/local.properties
/.idea/
# Session notes an agent writes beside the project. Untracked by default, which
# one `git add -A` undoes, and this repository is public.
/.claude/
/.kotlin/
*.iml
.DS_Store

# One line per depth rather than a bare `build/`. Anchoring to the root alone is
# what let 54MB of the sample's build output into this repo: `/build/` matches
# the root project's directory and nothing else, so every module added later is
# tracked by default.
/build/
*/build/
